{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleDetection": "force"
  },
  "include": ["extensions/**/*.ts", "tests/**/*.ts"]
}
